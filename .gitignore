# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
rivet_ex-*.tar


# Dialyzer PLT cache
/priv/plts/
/priv/*.cluster
/bench_results/

/priv/*.so

# SUMO benchmark: venv, generated scenario, trace, compiled binary
.sumo-venv/
test/bench/sumo/scenario/
test/bench/sumo/replay

# Native benches: compiled from the .c sources next to them. CI builds and runs them,
# then uploads the numbers. Never commit the binaries.
test/bench/pps_dram
test/bench/pps_native
test/bench/ring_native
test/bench/udp_recv
test/bench/zstd_frames
test/bench/fly/netbench

# The data plane build output is not committed.
native/**/build/

# iceoryx v1 and RouDi, built from source for a local run. The container image builds
# them too, so the source tree never holds the result. See deploy/Containerfile.
/.iceoryx/



# Cluster packages and their staging trees.
*.msi
*.deb
*.rpm
/pkgroot/
/stage/

# The generated compile database, wherever a build writes one.
compile_commands.json

# Lean: Lake build output. lake-manifest.json is committed, because it pins the
# dependency revisions the search was built against.
.lake/
