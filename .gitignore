# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
rivet_ex-*.tar


# Dialyzer PLT cache
/priv/plts/
/priv/*.cluster
/bench_results/

/priv/*.so

# SUMO benchmark: venv, generated scenario, trace, compiled binary
.sumo-venv/
test/bench/sumo/scenario/
test/bench/sumo/replay

# Native benches: compiled from the .c sources next to them. CI builds and runs them,
# then uploads the numbers. Never commit the binaries.
test/bench/pps_dram
test/bench/pps_native
test/bench/ring_native
test/bench/udp_recv
test/bench/zstd_frames
test/bench/fly/netbench

# Native planes and edges (C++): build output is not committed. gen/ holds the dlsym
# dispatch table and the prototypes, both generated from native/harness/iceoryx2.sigs.
native/**/build/
native/**/gen/

# iceoryx v1 and RouDi, built from source for a local run. The container image builds
# them too, so the source tree never holds the result. See deploy/Containerfile.
/.iceoryx/

# TLS material is ignored in native/edge/.gitignore instead of here. A rule at this level
# would also match native/edge/thirdparty/picoquic/certs/, which is vendored and tracked.


# Cluster packages and their staging trees.
*.msi
*.deb
*.rpm
/pkgroot/
/stage/

# Store plane: headers fetched for an editor, and the generated compile database.
native/storeplane/.deps/
compile_commands.json

# Store plane: the host CMake build that writes the compile database.
/.cmake-host/

/native/storeplane/witness/.lake/

# Lean: Lake build output. lake-manifest.json is committed, because it pins the
# dependency revisions the search was built against.
.lake/
