<?xml version="1.0" encoding="utf-8"?>
<!-- WiX authoring for the weft cluster MSI. It installs the control-plane release, the
     data plane, the versitygw S3 tier, and the community FoundationDB installer. It runs
     the FoundationDB installer (client and server), then registers and starts the weft
     Windows service. Build with WiX v5:
       wix build packaging/windows/weft.wxs -b stage -o weft-cluster.msi
     The stage directory holds rel\ (the OTP release), weft-dataplane.exe, versitygw.exe,
     and fdb-client-setup.exe. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="weft cluster"
           Manufacturer="v-sekai-multiplayer-fabric"
           Version="0.1.0"
           UpgradeCode="63b0529e-256b-436f-af7f-b47f3fd8f5c1"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of weft is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="weft">
        <Directory Id="RelDir" Name="rel" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="weft cluster" Level="1">
      <!-- The OTP release, harvested from stage\rel. -->
      <Files Include="rel\**" Directory="RelDir" />
      <Component Directory="INSTALLFOLDER">
        <File Source="weft-dataplane.exe" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="versitygw.exe" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="fdb-client-setup.exe" />
      </Component>
    </Feature>

    <!-- Install FoundationDB (client and server), then register and start the weft
         service through the release launcher. -->
    <CustomAction Id="InstallFdb" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]fdb-client-setup.exe&quot; /quiet"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="InstallWeftSvc" Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c &quot;[INSTALLFOLDER]rel\bin\weft.bat&quot; install"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="StartWeftSvc" Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c &quot;[INSTALLFOLDER]rel\bin\weft.bat&quot; start"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallFdb" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="InstallWeftSvc" After="InstallFdb" Condition="NOT Installed" />
      <Custom Action="StartWeftSvc" After="InstallWeftSvc" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
