# zone-server-h2o itself (task #20's actual deployment target),
# running the same image ci-local/Containerfile builds and tests
# (task #18's real build, reused as the runtime image too -- see that
# Containerfile's own comment on why). On-demand, like
# zone-server-h2o-fdb.container: no [Install] section, not enabled at
# boot, not auto-restarted.
#
# weft note: this process is a plane, so it has no networking and it
# needs no TLS material. The certs mount and the -p/-t/-k flags are
# gone with the transport, which moved to native/gyreedge. The SELinux
# :Z note that used to live here belongs with that mount, so it moved
# too. See ../../docs/reference/gyre_plane.md.
#
# Install: copy to ~/.config/containers/systemd/zone-server-h2o.container.

[Unit]
Requires=zone-server-h2o-ci-build.service zone-server-h2o-fdb.service
After=zone-server-h2o-ci-build.service zone-server-h2o-fdb.service

[Container]
Image=localhost/zone-server-h2o-ci:latest
ContainerName=zone-server-h2o
Network=host
Volume=zone-server-h2o-fdb-data:/var/fdb:ro,z
Exec=-a1 -c /var/fdb/fdb.cluster -z0
