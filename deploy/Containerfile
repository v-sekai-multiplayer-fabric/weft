# Build and run weft in a container. The versions match the CI: Elixir 1.20, OTP 29, and
# FoundationDB 7.3.76.
#
# Two targets:
#
#   dev      Elixir plus the sources. It runs `mix`, so it runs the tests and the
#            benches. Compose and the Quadlet units use it. This is the default.
#   release  The OTP release, the same artifact `release-native.yml` builds. Fly runs
#            it, so the deployed thing is the built thing.
#
#   docker build -f deploy/Containerfile --target dev     -t weft:dev .
#   docker build -f deploy/Containerfile --target release -t weft:release .
ARG ELIXIR_IMAGE=hexpm/elixir:1.20.3-erlang-29.0.5-debian-bookworm-20260803
ARG DEBIAN_IMAGE=debian:bookworm-slim
ARG FDB_VERSION=7.3.76
ARG ICEORYX2_VERSION=0.9.3
ARG RUST_IMAGE=docker.io/library/rust:1.90-bookworm

# ── iceoryx2 ────────────────────────────────────────────────────────────────────
# The zero-copy bus between planes. It is brokerless, so nothing from this stage runs as
# a daemon. Only the library and its headers move forward.
#
# This stage exists so the Rust toolchain stays here. weft writes no Rust. iceoryx2 is a
# dependency, and the harness links its C++ bindings. See docs/essays/runtime-choice.md.
#
# iceoryx v1 is not an option. Its Linux platform layer needs libacl, which is not
# allowed. See native/harness/README.md.
FROM ${RUST_IMAGE} AS iceoryx
ARG ICEORYX2_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends cmake ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://github.com/eclipse-iceoryx/iceoryx2/archive/refs/tags/v${ICEORYX2_VERSION}.tar.gz" \
      | tar -xz -C /tmp \
  && cmake -S "/tmp/iceoryx2-${ICEORYX2_VERSION}" -B /tmp/ice-build \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/iceoryx -DBUILD_EXAMPLES=OFF \
  && cmake --build /tmp/ice-build -j \
  && cmake --install /tmp/ice-build \
  && rm -rf /tmp/ice-build "/tmp/iceoryx2-${ICEORYX2_VERSION}"

# ── base ────────────────────────────────────────────────────────────────────────
FROM ${ELIXIR_IMAGE} AS base
ARG FDB_VERSION

# Build tools for the NIFs (exqlite, erlfdb, and the native data-plane NIF), plus the
# FoundationDB client library so erlfdb links against libfdb_c.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git curl ca-certificates \
  && curl -fsSL -o /tmp/fdb-clients.deb \
      "https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_amd64.deb" \
  && dpkg -i /tmp/fdb-clients.deb \
  && rm /tmp/fdb-clients.deb \
  && rm -rf /var/lib/apt/lists/*

# The bus, built in the stage above. The Rust toolchain does not come with it.
COPY --from=iceoryx /opt/iceoryx /opt/iceoryx
ENV CMAKE_PREFIX_PATH=/opt/iceoryx
ENV LD_LIBRARY_PATH=/opt/iceoryx/lib64

WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force

# Fetch the dependencies first. A later code change does not refetch them.
COPY mix.exs mix.lock ./
RUN mix deps.get

# ── dev ─────────────────────────────────────────────────────────────────────────
FROM base AS dev
COPY . .
RUN mix deps.compile && mix compile

# The store plane reads this cluster file to reach FoundationDB. Compose and the
# Quadlet unit both override it to the shared path.
ENV WEFT_FDB_CLUSTER_FILE=/etc/foundationdb/fdb.cluster

# Run the control plane. Override the command to run the tests or the stress bench, for
# example `mix test` or `mix run test/bench/sumo_tui.exs`.
CMD ["mix", "run", "--no-halt"]

# ── release builder ─────────────────────────────────────────────────────────────
FROM base AS builder
ENV MIX_ENV=prod
RUN mix deps.compile
COPY . .
RUN mix compile && mix release weft

# ── release ─────────────────────────────────────────────────────────────────────
# A runtime image with no Elixir and no sources. The release bundles ERTS, so it needs
# only the C libraries: libfdb_c for erlfdb, and the usual runtime bits.
FROM ${DEBIAN_IMAGE} AS release
ARG FDB_VERSION

# libsctp1 stops the ESOCK warning: the socket layer probes for SCTP at start and logs
# a failure when the library is absent.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libstdc++6 openssl ncurses-bin locales ca-certificates curl libsctp1 \
  && curl -fsSL -o /tmp/fdb-clients.deb \
      "https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_amd64.deb" \
  && dpkg -i /tmp/fdb-clients.deb \
  && rm /tmp/fdb-clients.deb \
  && apt-get purge -y curl \
  && rm -rf /var/lib/apt/lists/*

# The bus. A plane in this image links it, and no daemon runs beside a plane.
COPY --from=iceoryx /opt/iceoryx /opt/iceoryx
ENV LD_LIBRARY_PATH=/opt/iceoryx/lib64

WORKDIR /app
COPY --from=builder /app/_build/prod/rel/weft ./

ENV WEFT_FDB_CLUSTER_FILE=/etc/foundationdb/fdb.cluster

# The VM reads the locale to choose its filename encoding. A container with no locale
# gives latin1, and Elixir warns that it expects utf8. C.UTF-8 is built into the image.
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# `start` runs the release in the foreground, which is what a container wants. The
# release reads RELEASE_NODE and RELEASE_DISTRIBUTION from the environment. See
# deploy/fly/README.md.
CMD ["bin/weft", "start"]
