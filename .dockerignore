# Keep host build output out of the image. The host can be Windows, so a copied
# _build or priv holds beam files and a NIF for a different operating system. The
# image runs `mix deps.get` and `mix compile` itself. Without this file, a Windows
# NIF lands in priv/, make finds a target newer than the source, and the Linux build
# keeps the wrong binary. The NIF then fails to load with :nif_not_loaded.
_build/
deps/
priv/plts/
priv/*.so
cover/
doc/
tmp/
.sumo-venv/
erl_crash.dump

# Build output of the native planes and the benches.
native/**/build/
test/bench/pps_dram
test/bench/pps_native
test/bench/ring_native
test/bench/udp_recv
test/bench/zstd_frames
test/bench/sumo/replay
test/bench/sumo/scenario/
test/bench/fly/netbench

# Packages and their staging trees.
*.msi
*.deb
*.rpm
pkgroot/
stage/

# Not needed to build or run weft.
.git/
.github/
